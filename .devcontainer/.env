#===============================================================================
# DocumentReader Web Java Client - Enterprise Environment Variables
#===============================================================================
# Original Author: Regula Forensics Inc. (base repository)
# Dev Container Implementation: Dean Luus
# Email: dean.luus@jdconsulting.com
# GitHub: https://github.com/DeanLuus
# Date: 2025/03/27
# Last updated: 2025/03/27
#===============================================================================

#===============================================================================
# Container Configuration
#===============================================================================
CONTAINER_NAME=documentreader-web-java-client
PROJECT_DIR=/workspaces/DocumentReader-web-java-client
USER_NAME=vscode
USER_ID=1000
GROUP_ID=1000
DEBUG=true
NETWORK_MODE=host
PRIVILEGED_MODE=true
CONTAINER_CPU_LIMIT=2.0
CONTAINER_MEMORY_LIMIT=4g
CONTAINER_CPU_RESERVATION=0.5
CONTAINER_MEMORY_RESERVATION=2g
IMAGE_TAG=latest
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
NO_CACHE=false
INSTALL_TELEMETRY=false

#===============================================================================
# System Configuration
#===============================================================================
TZ=UTC
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
EDITOR=vi
PATH=/opt/gradle/bin:/opt/maven/bin:/usr/local/bin:/usr/bin:/bin
SHELL=/bin/bash
COLORTERM=truecolor
TERM=xterm-256color

#===============================================================================
# Java Configuration
#===============================================================================
JAVA_VERSION=17
JAVA_HOME=/opt/java/openjdk
JAVA_TOOL_OPTIONS=-Dfile.encoding=UTF8 -XX:+UseContainerSupport -XX:MaxRAMPercentage=80.0 -Djava.security.egd=file:/dev/./urandom

#===============================================================================
# Build Tool Configuration
#===============================================================================
# Gradle
GRADLE_VERSION=7.6.1
GRADLE_USER_HOME=/home/vscode/.gradle
GRADLE_VOLUME_NAME=documentreader-gradle-cache
GRADLE_CACHE_PATH=/tmp/gradle-cache
GRADLE_OPTS=-Dorg.gradle.daemon=true -Dorg.gradle.parallel=true -Dorg.gradle.caching=true -Dorg.gradle.configureondemand=true -Dorg.gradle.jvmargs="-Xmx2g -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp"

# Maven
MAVEN_VERSION=3.9.2
M2_HOME=/home/vscode/.m2
M2_VOLUME_NAME=documentreader-m2-cache
M2_CACHE_PATH=/tmp/m2-cache
MAVEN_OPTS=-Xmx2g -XX:+TieredCompilation -XX:TieredStopAtLevel=1

#===============================================================================
# Docker Configuration
#===============================================================================
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

#===============================================================================
# Project Configuration
#===============================================================================
# OpenAPI Generator
OPENAPI_GENERATOR_VERSION=v5.0.0-beta2
OPENAPI_DIR=/workspaces/DocumentReader-web-java-client/openapi
CONFIG_FILE=/workspaces/DocumentReader-web-java-client/client/java-generator-config.json
TEMPLATES_DIR=/workspaces/DocumentReader-web-java-client/client/generator-templates
CLIENT_OUTPUT_DIR=/workspaces/DocumentReader-web-java-client/client
RESOURCES_DIR=/workspaces/DocumentReader-web-java-client/example/src/main/resources

# Type mappings for OpenAPI generation
ENUM_MAPPINGS=MeasureSystem=Integer,TextFieldType=Integer,GraphicFieldType=Integer,Scenario=String,DocumentFormat=Integer,Light=Integer,Result=Integer,VerificationResult=Integer,RfidLocation=Integer,DocumentTypeRecognitionResult=Integer,ProcessingStatus=Integer,Source=String,CheckResult=Integer,LCID=Integer,DocumentType=Integer,CheckDiagnose=Integer,Critical=Integer,AuthenticityResultType=Integer,SecurityFeatureType=Integer,Visibility=Integer,ImageQualityCheckType=Integer,LogLevel=String,MRZFormat=String,TextPostProcessing=Integer

#===============================================================================
# Container Health & Monitoring
#===============================================================================
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=30s
HEALTH_FILE=/tmp/container-health
LOG_DIR=/tmp/devcontainer-logs
LOGS_VOLUME_NAME=documentreader-logs
LOGS_PATH=/tmp/container-logs
CHECK_INTERVAL=5
MAX_RETRIES=3
RETRY_DELAY=5
TIMEOUT=60

#===============================================================================
# Volume Configuration
#===============================================================================
VOLUME_DRIVER=local
VOLUME_TYPE=none
VOLUME_OPTIONS=bind
NETWORK_DRIVER=bridge
NETWORK_MTU=1500

#===============================================================================
# Development Settings
#===============================================================================
CI=false