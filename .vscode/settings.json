{
    // Java configuration
    "java.compile.nullAnalysis.mode": "automatic",
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.errors.incompleteClasspath.severity": "error",
    "java.jdt.ls.vmargs": "-noverify -Xmx4G -XX:+UseG1GC -XX:+UseStringDeduplication",
    // Editor settings
    "editor.minimap.enabled": true,
    "editor.renderWhitespace": "all",
    "editor.quickSuggestionsDelay": 10,
    "editor.tabSize": 4,
    "editor.suggestSelection": "first",
    "editor.parameterHints.enabled": true,
    "editor.fontLigatures": true,
    "editor.codeLens": true,
    "editor.inlineHints.enabled": true,
    "editor.formatOnSave": true,
    // GitHub Copilot settings
    "github.copilot.enable": true,
    "github.copilot.editor.enableAutoCompletions": true,
    "github.copilot.advanced": {
        "contextualMode": true
    },
    "github.copilot.experimental": {
        "advanced": true
    },
    "github.copilot.suggestionDelay": 0,
    "github.copilot.enableSemantic": true,
    "github.copilot.chat.generateTests.codeLens": true,
    "github.copilot.chat.edits.temporalContext.enabled": true,
    "github.copilot.chat.editor.temporalContext.enabled": true,
    "github.copilot.chat.edits.codesearch.enabled": true,
    "github.copilot.nextEditSuggestions.enabled": true
}